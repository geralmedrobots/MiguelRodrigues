[Unit]
Description=PharmaRobot dual LiDAR stack
Requires=pharmarobot.service
After=pharmarobot.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/pharmarobot
ExecStart=/usr/local/bin/pharma_run_lidar.sh
ExecStop=/usr/local/bin/pharma_stop_lidar.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
